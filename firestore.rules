      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to vendor profiles.
     * @path /vendors/{vendorId}
     * @allow (create) - Authenticated vendor creates their profile with matching vendorId.
     * @allow (get, update, delete) - Authenticated vendor accesses their own profile.
     * @deny (list) - Prevents listing of all vendor profiles.
     * @deny (create, update, delete) - Unauthorized vendor attempts to modify another vendor's profile.
     * @principle Enforces vendor-ownership for data access and modification.
     */
    match /vendors/{vendorId} {
      function isOwner(vendorId) {
        return request.auth != null && request.auth.uid == vendorId;
      }
      function isExistingOwner(vendorId) {
        return isOwner(vendorId) && resource != null;
      }
      allow get: if isOwner(vendorId);
      allow list: if false;
      allow create: if isOwner(vendorId) && request.resource.data.id == vendorId;
      allow update: if isExistingOwner(vendorId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(vendorId);
    }

    /**
     * @description Controls access to tours created by vendors.
     * @path /vendors/{vendorId}/tours/{tourId}
     * @allow (create) - Authenticated vendor creates a tour under their vendorId.
     * @allow (get, list, update, delete) - Authenticated vendor manages their own tours.
     * @deny (create, update, delete) - Unauthorized vendor attempts to modify another vendor's tours.
     * @principle Enforces vendor-ownership for data access and modification.
     */
    match /vendors/{vendorId}/tours/{tourId} {
      function isVendorOwner(vendorId) {
        return request.auth != null && request.auth.uid == vendorId;
      }
      function isExistingVendorOwner(vendorId) {
        return isVendorOwner(vendorId) && resource != null;
      }
      allow get: if isVendorOwner(vendorId);
      allow list: if isVendorOwner(vendorId);
      allow create: if isVendorOwner(vendorId);
      allow update: if isExistingVendorOwner(vendorId);
      allow delete: if isExistingVendorOwner(vendorId);
    }

    /**
     * @description Controls access to hotels managed by vendors.
     * @path /vendors/{vendorId}/hotels/{hotelId}
     * @allow (create) - Authenticated vendor creates a hotel under their vendorId.
     * @allow (get, list, update, delete) - Authenticated vendor manages their own hotels.
     * @deny (create, update, delete) - Unauthorized vendor attempts to modify another vendor's hotels.
     * @principle Enforces vendor-ownership for data access and modification.
     */
    match /vendors/{vendorId}/hotels/{hotelId} {
      function isVendorOwner(vendorId) {
        return request.auth != null && request.auth.uid == vendorId;
      }
      function isExistingVendorOwner(vendorId) {
        return isVendorOwner(vendorId) && resource != null;
      }
      allow get: if isVendorOwner(vendorId);
      allow list: if isVendorOwner(vendorId);
      allow create: if isVendorOwner(vendorId);
      allow update: if isExistingVendorOwner(vendorId);
      allow delete: if isExistingVendorOwner(vendorId);
    }

    /**
     * @description Controls access to vehicles managed by vendors.
     * @path /vendors/{vendorId}/vehicles/{vehicleId}
     * @allow (create) - Authenticated vendor creates a vehicle under their vendorId.
     * @allow (get, list, update, delete) - Authenticated vendor manages their own vehicles.
     * @deny (create, update, delete) - Unauthorized vendor attempts to modify another vendor's vehicles.
     * @principle Enforces vendor-ownership for data access and modification.
     */
    match /vendors/{vendorId}/vehicles/{vehicleId} {
      function isVendorOwner(vendorId) {
        return request.auth != null && request.auth.uid == vendorId;
      }
      function isExistingVendorOwner(vendorId) {
        return isVendorOwner(vendorId) && resource != null;
      }
      allow get: if isVendorOwner(vendorId);
      allow list: if isVendorOwner(vendorId);
      allow create: if isVendorOwner(vendorId);
      allow update: if isExistingVendorOwner(vendorId);
      allow delete: if isExistingVendorOwner(vendorId);
    }

    /**
     * @description Controls access to user travel plans.
     * @path /users/{userId}/plans/{planId}
     * @allow (create) - Authenticated user creates a plan under their userId, ensuring userId in the document matches the path.
     * @allow (get, list, update, delete) - Authenticated user accesses their own plans.
     * @deny (create, update, delete) - Unauthorized user attempts to modify another user's plans.
     * @principle Enforces user-ownership for data access and modification.
=======

      allow get: if isOwner(userId);
      allow list: if false; // Prevent listing of all users

      allow create: if request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Manages vendor information. Only admin users can create, update, or delete vendors.
     * @path /vendors/{vendorId}
     * @allow (create) Admin user creates a vendor profile at /vendors/vendor123.
     * @allow (get, update, delete) Admin user reads/updates/deletes a vendor profile at /vendors/vendor123.
     * @deny (create, update, delete) Non-admin user attempts to create/update/delete a vendor profile.
     * @principle Restricts vendor management to admins.
     */
    match /vendors/{vendorId} {
      function isAdmin() {
        return request.auth != null && get(/databases/$(database)/documents/roles/admin/$(request.auth.uid)).data.exists();
      }

      allow get: if true; // Public read
      allow list: if true; // Public list

      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @description Manages tours associated with a specific vendor. Only the associated vendor or an admin can manage tours.
     * @path /vendors/{vendorId}/tours/{tourId}
     * @allow (create) Vendor with ID 'vendor123' creates a tour at /vendors/vendor123/tours/tour456 with vendorId set to 'vendor123'.
     * @allow (get, update, delete) Vendor with ID 'vendor123' or Admin reads/updates/deletes tour at /vendors/vendor123/tours/tour456.
     * @deny (create, update, delete) Another vendor attempts to create/update/delete a tour under vendor 'vendor123'.
     * @principle Enforces vendor ownership and allows admin override.
     */
    match /vendors/{vendorId}/tours/{tourId} {
       function isVendor(vendorId) {
        return request.auth != null && get(/databases/$(database)/documents/vendors/$(vendorId)).data.exists();
      }

      allow get: if true; //Public read
      allow list: if true; //Public list
      allow create: if (request.auth != null && resource.data.vendorId == vendorId) || isAdmin();
      allow update: if (request.auth != null && resource.data.vendorId == vendorId) || isAdmin();
      allow delete: if (request.auth != null && resource.data.vendorId == vendorId) || isAdmin();
    }

    /**
     * @description Manages hotels associated with a specific vendor. Only the associated vendor or an admin can manage hotels.
     * @path /vendors/{vendorId}/hotels/{hotelId}
     * @allow (create) Vendor with ID 'vendor123' creates a hotel at /vendors/vendor123/hotels/hotel456 with vendorId set to 'vendor123'.
     * @allow (get, update, delete) Vendor with ID 'vendor123' or Admin reads/updates/deletes hotel at /vendors/vendor123/hotels/hotel456.
     * @deny (create, update, delete) Another vendor attempts to create/update/delete a hotel under vendor 'vendor123'.
     * @principle Enforces vendor ownership and allows admin override.
     */
    match /vendors/{vendorId}/hotels/{hotelId} {
       function isVendor(vendorId) {
        return request.auth != null && get(/databases/$(database)/documents/vendors/$(vendorId)).data.exists();
      }

      allow get: if true; //Public read
      allow list: if true; //Public list
      allow create: if (request.auth != null && resource.data.vendorId == vendorId) || isAdmin();
      allow update: if (request.auth != null && resource.data.vendorId == vendorId) || isAdmin();
      allow delete: if (request.auth != null && resource.data.vendorId == vendorId) || isAdmin();
    }

    /**
