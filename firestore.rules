
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }
    function isVendor() {
      return isAuthenticated() && (request.auth.token.role == 'vendor' || request.auth.token.role == 'admin');
    }
    function isUser() {
      return isAuthenticated() && (request.auth.token.role == 'user' || request.auth.token.role == 'vendor' || request.auth.token.role == 'admin');
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if isAdmin();
    }

    match /vendors/{vendorId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.ownerUid;
      allow update: if (isVendor() && request.auth.uid == resource.data.ownerUid) || isAdmin();
      allow delete: if isAdmin();
    }

    match /tours/{tourId} {
      allow get, list: if true;
      allow create: if (isVendor() && request.auth.uid == request.resource.data.vendorId) || isAdmin();
      allow update: if isAdmin() || (isVendor() && request.auth.uid == resource.data.vendorId);
      allow delete: if isAdmin() || (isVendor() && request.auth.uid == resource.data.vendorId);
    }

    match /hotels/{hotelId} {
      allow get, list: if true;
      allow create: if (isVendor() && request.auth.uid == request.resource.data.vendorId) || isAdmin();
      allow update, delete: if isAdmin() || (isVendor() && request.auth.uid == resource.data.vendorId);
    }

    match /vehicles/{vehicleId} {
      allow get, list: if true;
      allow create: if (isVendor() && request.auth.uid == request.resource.data.vendorId) || isAdmin();
      allow update, delete: if isAdmin() || (isVendor() && request.auth.uid == resource.data.vendorId);
    }

    match /bookings/{bookingId} {
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow read: if isAdmin() || request.auth.uid == resource.data.userId || request.auth.uid == resource.data.vendorId;
      allow update: if isAdmin()
                 || (isVendor() && request.auth.uid == resource.data.vendorId && request.resource.data.keys().hasOnly(['status']))
                 || (request.auth.uid == resource.data.userId && request.resource.data.keys().hasOnly(['status']) && request.resource.data.status in ['cancelled']);
      allow delete: if isAdmin();
    }

    match /itineraries/{itId} {
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow read: if resource.data.userId == request.auth.uid || resource.data.shared == true || isAdmin();
      allow update: if request.auth.uid == resource.data.userId || isAdmin();
      allow delete: if request.auth.uid == resource.data.userId || isAdmin();
    }

    match /reviews/{reviewId} {
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow read: if true;
      allow update, delete: if isAdmin() || (isAuthenticated() && request.auth.uid == resource.data.userId);
    }

    match /notifications/{notifId} {
      allow create: if isAdmin();
      allow read: if isAuthenticated() && request.auth.uid == resource.data.recipientId;
      allow update, delete: if isAdmin();
    }

    match /supportChats/{chatId} {
      allow read, create: if isAuthenticated() && (request.auth.uid in request.resource.data.participants || request.resource.data.participants has request.auth.uid) || isAdmin();
      allow write: if isAuthenticated() && (request.auth.uid in request.resource.data.participants) || isAdmin();
      match /messages/{msgId} {
        allow create: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/supportChats/$(chatId)).data.participants;
        allow read: if isAuthenticated() && request.auth.uid in resource.parent.data.participants || isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
